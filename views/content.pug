include includes/post.pug

doctype html
html(lang="en")
  include includes/head.pug
  body
    aside#leftside
    aside#rightside
    #container
      include includes/header.pug

      main
        include includes/photos.pug
        h2 Comments

        section#blogposts
          each item in posts
            +post(item.author, item.date, item.text)

      include includes/footer.pug
